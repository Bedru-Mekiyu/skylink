# =============================================================================
# Sky Link production environment file (template; copy to the server and name it ".env")
#
# - Fill the EMPTY values yourself on the server. Never commit a real .env.
# - If the live site already has a .env, KEEP ITS APP_KEY. A different APP_KEY
#   logs every admin out and breaks anything encrypted. Only add the keys that are missing.
# - After any change to .env on the server run:  php artisan config:clear && php artisan config:cache
# =============================================================================

# --- Application --------------------------------------------------------------
APP_NAME="Sky Link ICT Solutions"
# Must be "production": it also blocks the ANNIVERSARY_FORCE preview.
APP_ENV=production
# SECRET. Generate once with `php artisan key:generate --show` and paste it. Keep the existing one on a live site.
APP_KEY=
# Must be false on a public site (true prints stack traces to visitors).
APP_DEBUG=false
# The public address, with https. CONFIRM this matches the domain in cPanel.
APP_URL=https://skylinkict.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Logging ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# --- Database (MySQL on cPanel) ----------------------------------------------
# cPanel prefixes names with the account name, e.g. skylinkictcom_app. Create these in cPanel > MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
# SECRET
DB_PASSWORD=

# --- Sessions, cache and queue all use the database (tables come from the migrations) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only over https.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Mail (contact form, replies, newsletters) --------------------------------
# Use the SMTP account made in cPanel > Email Accounts (the "Connect Devices" page shows the server name and port).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
# SECRET
MAIL_PASSWORD=
# Sender address. Empty = COMPANY_EMAIL below.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sky Link ICT Solutions"

# --- The company email address: ONE line for everything ------------------------
# Shown on the Contact page, receives every form, and sends the website emails.
COMPANY_EMAIL=info@skylinkictet.com

# --- Where website messages are emailed ---------------------------------------
# One address receives every form (contact, support, quote, service, subscription).
CONTACT_INBOX=
# Optional: separate inboxes. Empty = CONTACT_INBOX.
QUOTE_INBOX=
SUPPORT_INBOX=
# "We received your message" email to the visitor.
CONTACT_CONFIRM_VISITOR=true
# Months before old messages are anonymised (0 = never).
CONTACT_RETENTION_MONTHS=24

# --- News times ----------------------------------------------------------------
NEWS_ADMIN_TIMEZONE=Africa/Addis_Ababa
NEWS_DISPLAY_TIMEZONE=Africa/Addis_Ababa

# --- Chat assistant (optional) -------------------------------------------------
# SECRET. Leave empty to switch the chat answers off.
DEEP_AI_API_KEY=

# --- Anniversary ceremony -------------------------------------------------------
# Deliberately NOT here. ANNIVERSARY_FORCE is a local/staging preview only and is ignored in production.
# The owner controls the ceremony in Admin > Anniversary Ceremony.
