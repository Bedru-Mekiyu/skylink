+    # ---- Sky Link (skylinkict.com and www only; no other host is affected) ----
+    # One address: https://skylinkict.com (http -> https, www -> non-www, in a single 301).
+    RewriteCond %{HTTP_HOST} ^(www\.)?skylinkict\.com$ [NC]
