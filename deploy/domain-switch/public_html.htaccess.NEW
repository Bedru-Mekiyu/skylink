<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # ---- Sky Link (skylinkict.com and www only; no other host is affected) ----
    # One address: https://skylinkict.com (http -> https, www -> non-www, in a single 301).
    RewriteCond %{HTTP_HOST} ^(www\.)?skylinkict\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://skylinkict.com%{REQUEST_URI} [L,R=301]

    # The home page: a folder, so DirectoryIndex would otherwise pick the old index.html (besirah-react).
    RewriteCond %{HTTP_HOST} ^skylinkict\.com$ [NC]
    RewriteRule ^$ skylink-front.php [L]

    # Everything that is not an existing file or folder goes to the Sky Link front controller (skylink-front.php).
    # Existing folders (erp/, newsite/, webpro/ ...) and files keep working exactly as before.
    RewriteCond %{HTTP_HOST} ^skylinkict\.com$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ skylink-front.php [L]
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
</IfModule>
<IfModule lsapi_module>
</IfModule>
# END cPanel-generated php ini directives, do not edit
AddType application/x-httpd-php .html

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Sky Link needs PHP 8.2+ (Laravel 12); this account's default for public_html is ea-php81.
# Only the uniquely named front controller is switched to 8.2, so no other site under public_html changes version.
<Files "skylink-front.php">
  <IfModule mime_module>
    AddHandler application/x-httpd-ea-php82___lsphp .php
  </IfModule>
</Files>
